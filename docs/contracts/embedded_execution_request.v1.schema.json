{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pdffast.execution.request.v1",
  "title": "PDFFast Embedded Execution Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "input", "options"],
  "properties": {
    "schema_version": {
      "const": "pdffast.execution.request.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_dpi": {
          "type": "integer",
          "minimum": 1
        },
        "region_dpi": {
          "type": "integer",
          "minimum": 1
        },
        "rapidocr_workers": {
          "type": "integer",
          "minimum": 1
        },
        "table_mode": {
          "enum": ["off", "auto", "all"]
        }
      }
    }
  }
}
