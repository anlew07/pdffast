{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pdffast.execution.request.v1",
  "title": "PDFFast Embedded Execution Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "input",
    "options"
  ],
  "properties": {
    "schema_version": {
      "const": "pdffast.execution.request.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        }
      }
    },
    "options": {
      "type": "object",
      "maxProperties": 0
    }
  }
}
