{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDFFast parser provenance V1",
  "type": "object",
  "required": [
    "schema_version",
    "profile_locked",
    "profile_name",
    "profile_sha256",
    "providers_config_sha256",
    "effective_config_fingerprint",
    "allowed_providers",
    "capability_routes",
    "pdffast_commit",
    "code_identity",
    "planned_task_count",
    "attempted_provider_counts",
    "selected_provider_counts",
    "accepted_task_count",
    "terminal_preserve_count",
    "pipeline_failure_count",
    "provider_execution_required",
    "execution_status",
    "preflight_status",
    "audit_passed",
    "outputs_written"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_locked": {
      "const": true
    },
    "profile_name": {
      "type": "string",
      "minLength": 1
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "providers_config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "effective_config_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "allowed_providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capability_routes": {
      "type": "object",
      "required": [
        "PAGE_DOCUMENT_OCR",
        "PAGE_DOCUMENT_LAYOUT_PARSE",
        "REGION_MULTIMODAL_PARSE",
        "INLINE_CONTEXT_PARSE"
      ],
      "properties": {
        "PAGE_DOCUMENT_OCR": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "PAGE_DOCUMENT_LAYOUT_PARSE": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "REGION_MULTIMODAL_PARSE": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "INLINE_CONTEXT_PARSE": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "pdffast_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "code_identity": {
      "type": "object",
      "required": [
        "pdffast_commit",
        "source_dirty",
        "source_sha256",
        "algorithm_sha256"
      ],
      "properties": {
        "pdffast_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "source_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "algorithm_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "planned_task_count": {
      "type": "integer",
      "minimum": 0
    },
    "attempted_provider_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "selected_provider_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "accepted_task_count": {
      "type": "integer",
      "minimum": 0
    },
    "terminal_preserve_count": {
      "type": "integer",
      "minimum": 0
    },
    "pipeline_failure_count": {
      "type": "integer",
      "minimum": 0
    },
    "provider_execution_required": {
      "type": "boolean"
    },
    "execution_status": {
      "enum": [
        "COMPLETED",
        "COMPLETED_WITH_PIPELINE_FAILURES"
      ]
    },
    "preflight_status": {
      "const": "PASS"
    },
    "audit_passed": {
      "const": true
    },
    "outputs_written": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "planned_task_count": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "attempted_provider_counts": {
            "maxProperties": 0
          },
          "selected_provider_counts": {
            "maxProperties": 0
          },
          "accepted_task_count": {
            "const": 0
          },
          "terminal_preserve_count": {
            "const": 0
          },
          "pipeline_failure_count": {
            "const": 0
          },
          "provider_execution_required": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "provider_execution_required": {
            "const": true
          },
          "attempted_provider_counts": {
            "minProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "COMPLETED"
          }
        }
      },
      "then": {
        "properties": {
          "pipeline_failure_count": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "pipeline_failure_count": {
            "minimum": 1
          }
        }
      }
    }
  ]
}
