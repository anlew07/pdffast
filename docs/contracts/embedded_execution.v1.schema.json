{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDFFast Embedded Execution Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "input",
    "result",
    "execution",
    "execution_evidence",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "pdffast.execution.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sha256",
        "byte_size",
        "status"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "const": "COMPLETE"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "markdown",
        "audit"
      ],
      "properties": {
        "document": {
          "$ref": "#/$defs/relative_path"
        },
        "markdown": {
          "$ref": "#/$defs/relative_path"
        },
        "audit": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_status",
        "pdffast_commit",
        "source_sha256",
        "profile_name",
        "profile_sha256",
        "providers_config_sha256",
        "effective_config_fingerprint",
        "policy_version",
        "allowed_providers",
        "provider_runtime",
        "attempted_provider_counts",
        "selected_provider_counts",
        "planned_task_count",
        "accepted_task_count",
        "terminal_preserve_count",
        "pipeline_failure_count",
        "escalated_count",
        "preflight_status",
        "audit_passed",
        "outputs_written"
      ],
      "properties": {
        "execution_status": {
          "enum": [
            "COMPLETED",
            "COMPLETED_WITH_PIPELINE_FAILURES"
          ]
        },
        "pdffast_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile_name": {
          "type": "string",
          "minLength": 1
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "providers_config_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "effective_config_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "allowed_providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provider_runtime": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "dependency_probe",
              "identity"
            ],
            "properties": {
              "status": {
                "const": "READY"
              },
              "dependency_probe": {
                "enum": [
                  "PASS",
                  "NOT_RUN"
                ]
              },
              "identity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "python",
                  "package_inventory_sha256",
                  "packages",
                  "model"
                ],
                "properties": {
                  "python": {
                    "type": "string",
                    "minLength": 1
                  },
                  "package_inventory_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "packages": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "model": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "attempted_provider_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "selected_provider_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "planned_task_count": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_task_count": {
          "type": "integer",
          "minimum": 0
        },
        "terminal_preserve_count": {
          "type": "integer",
          "minimum": 0
        },
        "pipeline_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "escalated_count": {
          "type": "integer",
          "minimum": 0
        },
        "preflight_status": {
          "const": "PASS"
        },
        "audit_passed": {
          "const": true
        },
        "outputs_written": {
          "const": true
        }
      }
    },
    "execution_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_manifest",
        "selected_prediction_index",
        "runtime_policy"
      ],
      "properties": {
        "production_manifest": {
          "$ref": "#/$defs/relative_path"
        },
        "selected_prediction_index": {
          "$ref": "#/$defs/relative_path"
        },
        "runtime_policy": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*(?:^|/)\\.(?:/|$))[^\\u0000]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "media_type",
        "byte_size",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "media_type": {
          "enum": [
            "application/json",
            "text/markdown",
            "text/plain"
          ]
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "media_type": {
                "const": "application/json"
              }
            },
            "required": [
              "media_type"
            ]
          },
          "then": {
            "properties": {
              "byte_size": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "selected_prediction"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "required": [
              "task_id"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "planned_task_count": {
                "const": 0
              }
            },
            "required": [
              "planned_task_count"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "attempted_provider_counts": {
                "maxProperties": 0
              },
              "selected_provider_counts": {
                "maxProperties": 0
              },
              "accepted_task_count": {
                "const": 0
              },
              "terminal_preserve_count": {
                "const": 0
              },
              "pipeline_failure_count": {
                "const": 0
              },
              "escalated_count": {
                "const": 0
              },
              "execution_status": {
                "const": "COMPLETED"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "execution": {
            "properties": {
              "attempted_provider_counts": {
                "minProperties": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "execution_status": {
                "const": "COMPLETED"
              }
            },
            "required": [
              "execution_status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "pipeline_failure_count": {
                "const": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "execution": {
            "properties": {
              "pipeline_failure_count": {
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "artifacts": {
          "allOf": [
            {
              "contains": {
                "properties": {
                  "name": {
                    "const": "document"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "name": {
                    "const": "markdown"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "name": {
                    "const": "audit"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "name": {
                    "const": "production_execution_manifest"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "name": {
                    "const": "selected_prediction_index"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "name": {
                    "const": "runtime_escalation_policy"
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          ]
        }
      }
    }
  ]
}
